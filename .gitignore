# Unity Version Control (Plastic SCM)
# ---------------------------------------------------------------
.plastic/
.plastic4/
ignore.conf
/[Aa]ssets/Plugins/PlasticSCM*

# ---------------------------------------------------------------
# IDEs y proyectos generados
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
.consulo/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Los .meta de los anteriores nunca deben versionarse
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------
# Builds y artefactos
# ---------------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties
sysinfo.txt

# ---------------------------------------------------------------
# Addressables (contenido generado)
# ---------------------------------------------------------------
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------
# Ficheros temporales de sincronización de Unity
# ---------------------------------------------------------------
~UnityDirMonSyncFile~*
*.private
*.private.meta

# ---------------------------------------------------------------
# Generador LPC clonado (89k ficheros de terceros, no se versiona)
# ---------------------------------------------------------------
/tools/LPC_Assets/
/tools/__pycache__/
*.pyc

# ---------------------------------------------------------------
# Claude Code Game Studios: estado efímero, no se versiona
# ---------------------------------------------------------------
/production/session-state/*
!/production/session-state/.gitkeep
/production/session-logs/

# Memoria por-agente autogenerada por Claude Code (no es contenido autoría del usuario)
/.claude/agent-memory/

