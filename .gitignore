# ---------------------------------------------------------------
# Unity
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store Tools
/[Aa]ssets/AssetStoreTools*

# Autoguardado de recuperación tras cierre inesperado/crash
/[Aa]ssets/_Recovery/

# Autogenerado por Unity al abrir el proyecto
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------------
# Unity Version Control (Plastic SCM)
# ---------------------------------------------------------------
.plastic/
.plastic4/
ignore.conf
/[Aa]ssets/Plugins/PlasticSCM*

# ---------------------------------------------------------------
# IDEs y proyectos generados
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
.consulo/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Los .meta de los anteriores nunca deben versionarse
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------
# Builds y artefactos
# ---------------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties
sysinfo.txt

# ---------------------------------------------------------------
# Addressables (contenido generado)
# ---------------------------------------------------------------
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------
# Ficheros temporales de sincronización de Unity
# ---------------------------------------------------------------
~UnityDirMonSyncFile~*
*.private
*.private.meta

# ---------------------------------------------------------------
# Guardados locales / volcados de depuración de pruebas fuera de StreamingAssets
# ---------------------------------------------------------------
*save*.json
save.json
*.save
/[Dd]ebug[Ss]aves/

# ---------------------------------------------------------------
# Claude Code: config/agentes local, no se versiona a partir de ahora
# ---------------------------------------------------------------
/.claude/

# ---------------------------------------------------------------
# Generador LPC clonado (89k ficheros de terceros, no se versiona)
# ---------------------------------------------------------------
/tools/LPC_Assets/
/tools/__pycache__/
*.pyc

# ---------------------------------------------------------------
# Claude Code Game Studios: estado efímero, no se versiona
# ---------------------------------------------------------------
/production/session-state/*
!/production/session-state/.gitkeep
/production/session-logs/

# Memoria por-agente autogenerada por Claude Code (no es contenido autoría del usuario)
/.claude/agent-memory/

# ---------------------------------------------------------------
# Documentación de ingeniería inversa (WIP, aún no revisada para commit)
# ---------------------------------------------------------------
/design/gdd/
/production/project-stage-report.md

# ---------------------------------------------------------------
# Documentación interna de proceso (roadmap, flujo de trabajo, ejemplos de
# sesión): no debe ser pública al abrir el repositorio.
# ---------------------------------------------------------------
/docs/

# ---------------------------------------------------------------
# ML-Agents (Fase 56): entorno de Python y salidas de entrenamiento
# ---------------------------------------------------------------
/.venv-mlagents/
/results/

# ---------------------------------------------------------------
# Originales del arte tal cual salen de Gemini (40 MB de .jfif). Unity ignora
# la carpeta por la virgulilla final, pero git no: hay que decirselo aparte.
# ---------------------------------------------------------------
/[Aa]ssets/_EndlessPull/Sprites/Base/Originales~/

# ---------------------------------------------------------------
# Restos de la plantilla URP de Unity: no son del juego
# ---------------------------------------------------------------
/[Aa]ssets/TutorialInfo/
/[Aa]ssets/TutorialInfo.meta
/[Aa]ssets/Readme.asset
/[Aa]ssets/Readme.asset.meta
/[Aa]ssets/Scenes/
/[Aa]ssets/Scenes.meta
/[Aa]ssets/Settings/SampleSceneProfile.asset
/[Aa]ssets/Settings/SampleSceneProfile.asset.meta

# ---------------------------------------------------------------
# Volcados de perfilado que deja ML-Agents dentro de Assets
# ---------------------------------------------------------------
/[Aa]ssets/ML-Agents/Timers/
/[Aa]ssets/ML-Agents/Timers.meta

# ---------------------------------------------------------------
# Entornos de Python y cachés fuera de tools/
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/

# ---------------------------------------------------------------
# Salidas de compilacion de plataforma (Android/WebGL): CMake, ninja y Burst
# ---------------------------------------------------------------
/.utmp/
/Data/Plugins/
/[Ee]xport/

# Volcado de trabajo vacio de una sesion vieja
/heroes_missing.json
