  m_Script: {fileID: 11500000, guid: 3df8cd4782577a84fa7afa24c51b6e8f, type: 3}
  m_Name: Hero_Kaelith_3Star
  m_EditorClassIdentifier: Assembly-CSharp::HeroData
  heroName: Kaelith
  title: El Que Rompió el Cerco
  origin: Reino Fronterizo
  bio: "Kaelith cuenta que rompió el cerco de un fuerte fronterizo él solo; nadie lo ha desmentido, y menos aún quien estaba allí. La historia crece cada vez que la cuenta, pero el filo no ha perdido nada."
  bioEn: "Kaelith claims he broke a border fort's siege single-handed; no one's disputed it, least of all those who were there. The story grows every time he tells it, but the blade's lost none of its edge."
  bioJa: "国境の砦の包囲を単身で破ったと語るケイリス。実際にその場にいた者ですら否定しない。語るたびに話は大きくなるが、剣の切れ味は少しも衰えていない。"
  bodySprite: {fileID: -3429057358050773073, guid: 3821e60ae24d7da4db624f9d3ffd6058, type: 3}
