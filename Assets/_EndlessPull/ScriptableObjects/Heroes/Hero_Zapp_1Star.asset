  m_Script: {fileID: 11500000, guid: 3df8cd4782577a84fa7afa24c51b6e8f, type: 3}
  m_Name: Hero_Zapp_1Star
  m_EditorClassIdentifier: Assembly-CSharp::HeroData
  heroName: Zapp
  title: Novato de la Vanguardia
  origin: Reino Fronterizo
  bio: "Zapp corre hacia la pelea antes de que nadie más haya terminado de desenvainar, y luego se pregunta por qué siempre llega solo. Su velocidad compensa lo que le falta de paciencia."
  bioEn: "Zapp sprints into a fight before anyone else has finished drawing their weapon, then wonders why he always arrives alone. His speed makes up for what he lacks in patience."
  bioJa: "ザップは誰も剣を抜き終わらないうちに突っ込んでいき、なぜいつも一人で戦っているのか首をかしげる。忍耐の足りなさは、その速さで補っている。"
  memories:
  - starRank: 0
    unlock: 3
    amount: 90
    text: "Corrió hacia la primera pelea sin esperar a nadie. Todavía no ha aprendido a esperar."
    textEn: "He ran into the first fight without waiting for anyone. He still hasn't learned to wait."
    textJa: "最初の戦いに、誰も待たずに駆け出した。今もまだ、待つことを覚えていない。"
  bodySprite: {fileID: -7022705497193458277, guid: 348c0668a0a0a7343be290f7d5be02ed, type: 3}
