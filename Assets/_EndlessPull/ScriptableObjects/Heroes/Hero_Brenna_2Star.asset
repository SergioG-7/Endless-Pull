  m_Script: {fileID: 11500000, guid: 3df8cd4782577a84fa7afa24c51b6e8f, type: 3}
  m_Name: Hero_Brenna_2Star
  m_EditorClassIdentifier: Assembly-CSharp::HeroData
  heroName: Brenna
  title: Cazadora de las Lomas Grises
  origin: Lomas Grises
  bio: "Brenna aprendió a rastrear antes que a caminar bien, siguiendo a su madre entre las Lomas Grises en busca de ciervos y lobos solitarios. Ahora rastrea algo más peligroso, y no falla un solo tiro."
  bioEn: "Brenna learned to track before she could walk properly, following her mother through the Grey Downs after deer and lone wolves. Now she tracks something far more dangerous, and she doesn't miss a shot."
  bioJa: "ブレンナは歩き方を覚えるより先に、母について灰色の丘陵で鹿や一匹狼を追う術を学んだ。今ではもっと危険なものを追っているが、矢を外したことはない。"
  bodySprite: {fileID: 8663988539916645547, guid: 35750e9f4df10648eaf188169b1eb483, type: 3}
