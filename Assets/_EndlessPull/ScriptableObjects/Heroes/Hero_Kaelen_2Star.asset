  m_Script: {fileID: 11500000, guid: 3df8cd4782577a84fa7afa24c51b6e8f, type: 3}
  m_Name: Hero_Kaelen_2Star
  m_EditorClassIdentifier: Assembly-CSharp::HeroData
  heroName: Kaelen
  title: Novato de la Vanguardia
  origin: Reino Fronterizo
  bio: "Kaelen ayudaba a arrear el ganado fronterizo cuando una manada de lobos le enseñó a pelear más rápido de lo que ningún instructor podría. Todavía huele el peligro antes de verlo."
  bioEn: "Kaelen used to help drive frontier cattle when a wolf pack taught him to fight faster than any instructor could. He still smells danger before he sees it."
  bioJa: "国境の牛を追っていたケイレンは、狼の群れに襲われてどの教官よりも早く戦い方を叩き込まれた。今でも、目にする前に危険を嗅ぎ取る。"
  memories:
  - starRank: 0
    unlock: 2
    amount: 25
    text: "Recuerda el instante exacto en que el silbido de aviso se volvió gruñido, y ya no lo confundió nunca más."
    textEn: "Recalls the exact moment the warning whistle turned into a growl, and never mistook one for the other again."
    textJa: "警笛がうなり声に変わった、その一瞬を覚えている。それ以来、二つを間違えたことはない。"
  bodySprite: {fileID: -2254043511531407488, guid: 9a74e8934c1ca7a459f27cda9de8f0b4, type: 3}
